 from training_metrics_dashboard import append_metric_row, maybe_update_dashboard  # noqa: E402
 
 
+# ---------------------------------------------------------------------------------------------------------------
+# [promptlock_patch_v1] training-time legality mask with the prompt locked (config: training.legality_mask, default
+# false = the July-control trainer unchanged). Before the CE (train and dev), at every position whose state is
+# (cursor, canvas_len) with prompt length P (= the collator's prefix_lens):
+#   MOVE amt  -> -inf  if cursor + amt < P  or  cursor + amt > canvas_len   (moving exactly to P stays legal)
+#   DELETE    -> -inf  if cursor <= P                                       (DELETE pops the token left of cursor)
+# Inserts and END_OF_RESPONSE are never masked, so every row keeps finite logits. A gold label that the mask
+# forbids would give an infinite loss: it is counted, logged and raises (never trained on silently).
+# ---------------------------------------------------------------------------------------------------------------
+_PL_DELETE = int(SPECIAL_TOKENS.delete)                       # 50259
+_PL_MOVE_IDS = [int(x) for x in get_all_move_token_ids()]     # 50261..50280: +1,-1,+2,-2,...,+512,-512
+_PL_MOVE_AMTS = [int(get_move_amount(x)) for x in _PL_MOVE_IDS]
+_PL_LO = _PL_DELETE                                           # masked column block [_PL_LO, _PL_HI)
+_PL_HI = max(_PL_MOVE_IDS) + 1
+assert _PL_MOVE_IDS == list(range(_PL_MOVE_IDS[0], _PL_HI)) and _PL_MOVE_IDS[0] == _PL_DELETE + 2
+
+
+def _promptlock_illegal_block(cursor: torch.Tensor, canvas_len: torch.Tensor, prefix_lens: torch.Tensor) -> torch.Tensor:
+    """(B,S,_PL_HI-_PL_LO) bool: True = action column illegal at that position (block starts at DELETE id)."""
+    amts = torch.tensor(_PL_MOVE_AMTS, dtype=torch.long, device=cursor.device)
+    new = cursor.unsqueeze(-1) + amts                                  # (B,S,20)
+    p = prefix_lens.to(cursor.device).long().view(-1, 1, 1)
+    ill_mv = (new < p) | (new > canvas_len.unsqueeze(-1))
+    ill_del = cursor <= p[:, :, 0]                                     # (B,S)
+    blk = torch.zeros(cursor.shape + (_PL_HI - _PL_LO,), dtype=torch.bool, device=cursor.device)
+    blk[..., 0] = ill_del
+    blk[..., _PL_MOVE_IDS[0] - _PL_LO:] = ill_mv
+    return blk
+
+
+def _promptlock_mask_logits(logits: torch.Tensor, labels: torch.Tensor, batch: Dict[str, Any], *, where: str):
+    """Return (masked logits, labels_checked, illegal_labels). Raises on any illegal gold label."""
+    cur, ln, pl = batch["legal_cursor"], batch["legal_canvas_len"], batch["prefix_lens"]
+    blk = _promptlock_illegal_block(cur, ln, pl)
+    valid = labels != -100
+    in_blk = valid & (labels >= _PL_LO) & (labels < _PL_HI)
+    idx = (labels - _PL_LO).clamp(0, _PL_HI - _PL_LO - 1).unsqueeze(-1)
+    bad = in_blk & blk.gather(-1, idx).squeeze(-1)
+    n_bad = int(bad.sum().item())
+    n_checked = int(valid.sum().item())
+    if n_bad:
+        pos = bad.nonzero()[:10].tolist()
+        det = [{"row": b, "t": t, "label": int(labels[b, t]), "cursor": int(cur[b, t]), "canvas_len": int(ln[b, t]),
+                "prefix_len": int(pl[b])} for b, t in pos]
+        print(f"[promptlock] FATAL {where}: {n_bad} gold label(s) illegal under the legality mask "
+              f"(of {n_checked} labels); first: {det}", flush=True)
+        raise RuntimeError(f"[promptlock] {n_bad} illegal gold labels in a {where} batch; refusing to train on an "
+                           f"infinite loss (see log)")
+    out = logits.clone()
+    out[..., _PL_LO:_PL_HI].masked_fill_(blk, float("-inf"))
+    return out, n_checked, n_bad
+
